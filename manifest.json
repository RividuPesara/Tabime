{
  "manifest_version": 3,
  "name": "Tabime",
  "version": "1.1.0",
  "description": "Save the anime you're watching by clicking the toolbar icon. Resolves the tab title via AniList or MyAnimeList.",
  "browser_specific_settings": {
    "gecko": {
      "id": "anime-tracker@animetracker.addon",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": [
    "https://myanimelist.net/*",
    "https://api.myanimelist.net/*"
  ],
  "background": {
    "scripts": [
      "lib/config.js",
      "lib/anilist.js",
      "lib/mal.js",
      "lib/auth.js",
      "background/background.js"
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
